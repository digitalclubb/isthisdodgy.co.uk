# All keys are optional. Each enricher gracefully no-ops when its key is missing.
# Keys go in Vercel project settings (or .env.local for development).

# IPQualityScore. One key covers URL, email and phone fraud-score lookups.
# Free tier on signup at https://www.ipqualityscore.com/create-account
# Limits depend on lookup type (URL ~5k/mo, email ~5k/mo, phone ~1k/mo).
IPQS_KEY=

# Google Safe Browsing v4 Lookup. Free tier, attribution required.
# https://developers.google.com/safe-browsing/v4/get-started
# v4 sunsets 31 March 2027. Plan a v5 hashLists migration before then.
GOOGLE_SAFE_BROWSING_KEY=

# URLhaus by abuse.ch. Free Auth-Key from https://auth.abuse.ch/
# Required since 30 June 2025. Non-commercial / fair-use only.
URLHAUS_AUTH_KEY=

# EmailRep.io free key from https://emailrep.io/free
# 250 lookups / month, 10 / day on the free tier. Anonymous works but is
# heavily throttled, so a key is strongly recommended.
EMAILREP_KEY=

# Per-IP request budget for the API and lookup routes, per minute. Optional.
# Defaults to 30. Raise it if you expect heavier legitimate traffic.
RATE_LIMIT_PER_MINUTE=
